# NextAutoDesk deployment environment
# =============================================================================
# Copy to .env next to docker-compose.yml, then edit. Keep the file mode 600:
# it contains the API keys.
#
#   cp deploy/.env.example .env
#   chmod 600 .env
#   openssl rand -hex 32        # put the result into NEXT_AUTODESK_API_KEYS
# =============================================================================

# --- API authentication (required) -------------------------------------------
# Comma separated list of API keys. Header: X-API-Key (or Authorization: Bearer).
NEXT_AUTODESK_API_KEYS=replace-with-openssl-rand-hex-32

# --- Image tag (required; written by the deployment scripts) -----------------
# Docker image tag to run. deploy/vps/deploy.sh and deploy/vps/build-on-host.sh
# write this automatically, derived from pyproject.toml (PEP 440 pre-releases
# become dash tags, e.g. "1.2.3a1" -> "1.2.3-alpha1"). When you deploy manually,
# set it to the tag you built or pulled; override it to pin a rollback build.
NAD_IMAGE_TAG=0.1.0-alpha1

# --- Networking (optional) ---------------------------------------------------
# Interface/port the API is published on. Bind to a private IP or 127.0.0.1 if
# the API is only reachable through a reverse proxy / SSH tunnel.
NAD_BIND_IP=0.0.0.0
NAD_PORT=8765

# --- Storage (optional) ------------------------------------------------------
# Host directory mounted at /data (SQLite DB, screenshots, logs). It must be
# writable by uid/gid 1000 (the container's "nad" user):
#   mkdir -p data && chown -R 1000:1000 data
NAD_DATA_DIR=./data

# Host directory mounted read-only at /app/config. Put nextautodesk.yml there
# to override the built-in configuration. It must be readable by uid 1000.
NAD_CONFIG_DIR=./config

# --- Logging / timezone (optional) ------------------------------------------
NEXT_AUTODESK_LOG_LEVEL=INFO
TZ=UTC

# --- VNC (reserved; only with deploy/docker-compose.vnc.example.yml) --------
# Never expose VNC on a public interface: bind it to 127.0.0.1 and use an SSH
# tunnel (ssh -L 5900:127.0.0.1:5900 <user>@<vps-host>) or a TLS-terminating proxy.
# NAD_VNC_BIND_IP=127.0.0.1
# NAD_VNC_PORT=5900
